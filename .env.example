# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values
# For Vercel deployment, set these in: Settings > Environment Variables

# ============================================
# Database (REQUIRED)
# ============================================
# Get from: Supabase Dashboard > Settings > Database > Connection String
# ⚠️ IMPORTANT: Select "Use connection pooling" for production
DATABASE_URL="postgresql://postgres.yourproject:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Get from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://yourproject.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================
# Authentication (REQUIRED)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="your-generated-32-char-minimum-secret"
CSRF_SECRET="your-generated-32-char-minimum-secret"

# Your application URL (use your domain or Vercel preview URL)
BETTER_AUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ============================================
# Payment Gateway (OPTIONAL)
# ============================================
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_WEBHOOK_SECRET="your-webhook-secret"
# The slug of the Paystack Payment Page to read the price from (e.g., 'ideacloner-complete')
PAYSTACK_PAYMENT_PAGE_SLUG="your-payment-page-slug"

# ============================================
# Email Service (OPTIONAL)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@yourdomain.com"

# ============================================
# OAuth Providers (OPTIONAL)
# ============================================
# Google OAuth - Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth - Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
# ============================================
# Application Settings
# ============================================
NEXT_PUBLIC_APP_NAME="Your SaaS Platform"
# Currency code (e.g. NGN, KES, USD) - Defaults to NGN
NEXT_PUBLIC_CURRENCY="NGN"
NODE_ENV="development"

# Admin Configuration
# Comma-separated email addresses for admin access
ADMIN_EMAILS="admin@yourdomain.com,admin2@yourdomain.com"

# Optional: Comma-separated IPs for admin panel access restriction
ADMIN_IPS=""

# ============================================
# Rate Limiting (OPTIONAL - RECOMMENDED FOR PRODUCTION)
# ============================================
# Uses in-memory fallback if not set
# For production, sign up at: https://upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production:
#
# 1. ✅ All REQUIRED variables are set with real values
# 2. ✅ Secrets are unique (not copied from this example)
# 3. ✅ Database password is strong (min 16 characters)
# 4. ✅ BETTER_AUTH_SECRET is 32+ random characters
# 5. ✅ CSRF_SECRET is 32+ random characters
# 6. ✅ Application URLs point to your production domain
# 7. ✅ Supabase RLS policies are enabled
# 8. ✅ Environment variables are set in Vercel Dashboard
#
# For detailed deployment instructions, see: key-files/DEPLOYMENT.md